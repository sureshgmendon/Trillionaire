# ==============================================================================
# TRILLIONAIRE ALGO ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate credentials before starting services.
# ==============================================================================

# Application & Operational Mode
APP_NAME="Trillionaire Algo Engine"
ENVIRONMENT="development"
TRADING_MODE="PAPER"                       # Options: PAPER, LIVE, REPLAY
ACTIVE_CAPITAL_TIER="TIER_0_PAPER"         # Options: TIER_0_PAPER, TIER_1_MICRO, TIER_2_GROWTH, TIER_3_SCALE
LOG_LEVEL="INFO"

# Zerodha Kite Connect Production API Credentials
KITE_API_KEY="your_kite_api_key_here"
KITE_API_SECRET="your_kite_api_secret_here"
KITE_ACCESS_TOKEN=""                       # Populated automatically upon successful daily auth
KITE_TOTP_SECRET="your_totp_secret_here"   # Base32 TOTP secret string for 2FA automation
KITE_USER_ID="your_zerodha_client_id"
KITE_PASSWORD="your_zerodha_password"

# Infrastructure Services
REDIS_URL="redis://localhost:6379/0"
POSTGRES_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trillionaire"

# Sentinel Risk Radar & AI News Triage
GEMINI_API_KEY=""                         # Google Gemini API key for overnight pre-market news classification
NEWS_API_KEY=""                           # Optional financial news aggregator key

# Telegram Push Alerts & Remote Operator Control
TELEGRAM_BOT_TOKEN=""                     # Telegram Bot API token from @BotFather
TELEGRAM_CHAT_ID=""                       # Authorized Telegram User/Group Chat ID
TRILLIONAIRE_ADMIN_KEY="trillionaire-dev-secret-key-change-in-prod" # Secret key for /api/v1/control/*

# Algorithmic Trading Window Constraints (IST 24-hr format HH:MM)
NO_ENTRY_BEFORE="09:25"                   # Inhibit entries during pre-open & initial 10-min volatility
NO_ENTRY_AFTER="14:30"                    # Cease new intraday entries to avoid end-of-day decay
FORCE_SQUARE_OFF="15:10"                  # Liquidate all open MIS intraday positions before Zerodha auto square-off
