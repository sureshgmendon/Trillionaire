# ==============================================================================
# TRILLIONAIRE ALGO ENGINE - PRODUCTION DOCKERFILE (FASTAPI ENGINE)
# Multi-stage, non-root user, timezone Asia/Kolkata, high-performance runtime
# ==============================================================================

# Stage 1: Build & wheels caching
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /install

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --prefix=/install -r requirements.txt

# Stage 2: Production Minimal Runtime
FROM python:3.11-slim-bookworm AS runner

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Kolkata \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/install/bin:${PATH}" \
    PYTHONPATH="/opt/trillionaire"

# Install runtime dependencies and set IST timezone
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    curl \
    libpq5 \
    ca-certificates \
    && ln -fs /usr/share/zoneinfo/Asia/Kolkata /etc/localtime \
    && echo "Asia/Kolkata" > /etc/timezone \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && rm -rf /var/lib/apt/lists/*

# Create institutional unprivileged user
RUN groupadd -g 10001 trillionaire && \
    useradd -u 10001 -g trillionaire -s /bin/bash -m trillionaire

WORKDIR /opt/trillionaire

# Copy installed Python packages from builder stage
COPY --from=builder /install /usr/local

# Copy application monorepo
COPY --chown=trillionaire:trillionaire . /opt/trillionaire

# Ensure logs, research artifacts, data store, and cache directories exist and are writable
RUN mkdir -p /opt/trillionaire/logs \
             /opt/trillionaire/research_lab/artifacts \
             /opt/trillionaire/research_lab/data_store \
             /opt/trillionaire/sentinel/artifacts && \
    chown -R trillionaire:trillionaire /opt/trillionaire && \
    chmod -R 775 /opt/trillionaire/logs \
                 /opt/trillionaire/research_lab/artifacts \
                 /opt/trillionaire/research_lab/data_store \
                 /opt/trillionaire/sentinel/artifacts

USER trillionaire

# Expose FastAPI REST / WS telemetry port
EXPOSE 8000

# Healthcheck testing FastAPI /api/v1/health endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "api_bridge.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--access-log"]
